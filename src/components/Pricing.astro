---
type Tier = {
  label: string;
  price: string;
  sub?: string;
  desc: string;
  featured?: boolean;
  blue?: boolean;
  href?: string;
};
const india: Tier[] = [
  { label: 'Diagnosis', price: 'Free', sub: 'or ₹1,999 for deep manual review', desc: 'Initial assessment of infection type and scope', featured: false },
  { label: 'Malware Cleanup', price: '₹14,999+', sub: 'Starting price', desc: 'Malware removal, cleanup, and basic hardening', featured: false },
  { label: 'Full Recovery', price: '₹29,999+', sub: 'Starting price', desc: 'Full hacked site recovery for business-critical websites', featured: true },
  { label: 'Emergency Same-Day', price: '₹49,999+', sub: 'Starting price', desc: 'Priority same-day recovery with dedicated attention', featured: false },
  { label: 'WooCommerce / Critical', price: '₹75,000+', sub: 'Starting price', desc: 'For stores, lead-heavy sites, and complex hacked environments', featured: false },
  { label: 'Monthly Protection', price: 'From ₹9,999/mo', sub: 'Lite · Pro · Critical', desc: 'Monitoring, backups, updates, and security — see the plans below', featured: false, blue: true, href: '#protection' },
];
---
<section class="py-20 px-4 bg-white" id="pricing">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-14" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Transparent Pricing</h2>
      <p class="text-gray-600 max-w-xl mx-auto">India-focused emergency WordPress recovery pricing. You receive a clear scope and fixed quote before we begin. No hidden charges. Prices shown are starting points — complex cases quoted individually.</p>
    </div>

    <div class="mb-12" data-reveal>
      <div class="flex items-center gap-3 mb-6">
        <span class="bg-orange-100 text-orange-700 font-bold text-sm px-3 py-1 rounded-lg flex-shrink-0">India (INR)</span>
        <div class="h-px bg-gray-200 flex-1"></div>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-5">
        {india.map((tier) => {
          const Tag = tier.href ? 'a' : 'div';
          return (
            <Tag
              href={tier.href}
              class={`block rounded-2xl p-6 text-center transition-all duration-200 relative ${
                tier.featured
                  ? 'border-2 border-blue-600 shadow-xl shadow-blue-100'
                  : tier.blue
                  ? 'border border-blue-200 bg-blue-50 hover:border-blue-300 hover:shadow-sm'
                  : 'border border-gray-200 hover:border-blue-200 hover:shadow-sm'
              }`}
            >
              {tier.featured && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-xs font-bold px-4 py-1 rounded-full whitespace-nowrap">
                  MOST REQUESTED
                </div>
              )}
              <div class={`text-sm font-semibold mb-2 ${tier.featured ? 'text-blue-600' : tier.blue ? 'text-blue-700' : 'text-gray-500'}`}>{tier.label}</div>
              <div class="text-2xl font-extrabold text-slate-900 mb-1">{tier.price}</div>
              {tier.sub && <div class="text-xs text-gray-400 mb-3">{tier.sub}</div>}
              <p class="text-xs text-gray-500 leading-relaxed">{tier.desc}</p>
            </Tag>
          );
        })}
      </div>
    </div>

    <p class="text-center text-xs text-gray-400 mt-8">
      All prices are starting points. Exact quote provided after diagnosis.<br>
      Payment: UPI and bank transfer accepted in India.
    </p>

  </div>
</section>
