---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical = 'https://www.wordpressrecovery.in/' } = Astro.props;
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
const gaId = import.meta.env.PUBLIC_GA_ID;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {gaId && <GoogleAnalytics id={gaId} />}

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow" />

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="WordPressRecovery.in" />
  <meta property="og:locale" content="en_IN" />

  <!-- Open Graph Image -->
  <meta property="og:image" content="https://www.wordpressrecovery.in/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://www.wordpressrecovery.in/og-image.png" />

  <!-- Fonts — non-blocking load to avoid render delay on mobile -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </noscript>

  <!-- JSON-LD LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "WordPressRecovery.in",
    "description": "Emergency WordPress recovery, malware removal, and security hardening for Indian businesses by WebAdish LLP.",
    "url": "https://www.wordpressrecovery.in",
    "telephone": "+919998757045",
    "email": "help@wordpressrecovery.in",
    "areaServed": [
      { "@type": "Country", "name": "India" }
    ],
    "priceRange": "₹14,999 – ₹75,000+",
    "parentOrganization": {
      "@type": "Organization",
      "name": "WebAdish LLP",
      "url": "https://webadish.com"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "WordPress Recovery Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "WordPress Malware Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Hacked WordPress Recovery" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Google Blacklist Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "WordPress Security Hardening" } }
      ]
    }
  }
  </script>

  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
